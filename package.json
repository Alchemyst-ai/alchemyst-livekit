{
  "name": "livekit-plugin-alchemyst",
  "version": "0.1.0",
  "description": "LiveKit Agents plugin that integrates the Alchemyst AI context layer for persistent voice-agent memory.",
  "keywords": [
    "livekit",
    "agents",
    "alchemyst",
    "memory",
    "voice",
    "ai"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "example": "tsx examples/agent.ts"
  },
  "peerDependencies": {
    "@livekit/agents": ">=1.0.0",
    "zod": ">=3.0.0"
  },
  "dependencies": {
    "@alchemystai/sdk": "^0.11.1"
  },
  "devDependencies": {
    "@livekit/agents": "^1.0.0",
    "@livekit/agents-plugin-cartesia": "^1.2.2",
    "@livekit/agents-plugin-deepgram": "^1.0.0",
    "@livekit/agents-plugin-elevenlabs": "^1.0.0",
    "@livekit/agents-plugin-google": "^1.2.2",
    "@livekit/agents-plugin-livekit": "^1.0.0",
    "@livekit/agents-plugin-openai": "^1.0.0",
    "@livekit/agents-plugin-silero": "^1.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.0"
  }
}
